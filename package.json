{
  "name": "eats",
  "private": true,
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "npm run dev --workspace @eats/api & npm run dev --workspace @eats/web",
    "dev:api": "npm run dev --workspace @eats/api",
    "dev:web": "npm run dev --workspace @eats/web",
    "build": "npm run build --workspace @eats/web",
    "start": "npm run start --workspace @eats/api",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspace @eats/api",
    "db:generate": "npm run db:generate --workspace @eats/api",
    "db:migrate": "npm run db:migrate --workspace @eats/api"
  },
  "devDependencies": {
    "typescript": "^7.0.2"
  }
}
