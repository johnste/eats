# Postgres connection string
DATABASE_URL=postgres://eats:eats@localhost:5432/eats

# Secret used to sign the session cookie. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Open Food Facts asks for a descriptive User-Agent and rate-limits on it.
OFF_USER_AGENT=Eats/1.0 (john@johnste.se)

# First invite code, so you can register the initial account.
INVITE_BOOTSTRAP_CODE=change-me

PORT=3000
NODE_ENV=development
